# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in ONE AI key.
# Server-side only: read by the /api/chat proxy (vite.config.js in dev,
# server/index.js for `npm start`). These names have no VITE_ prefix, so
# they are never put into the browser bundle.
# Without any key the app still runs; the chatbot shows a "not connected"
# message.
# ---------------------------------------------------------------------------

# Which AI to use: gemini, anthropic or ollama. Leave empty to use whichever
# key below is filled in (Anthropic wins if both are). Ollama is only used
# when chosen here.
AI_PROVIDER=gemini

# Option 1 (free): Google Gemini. Get a key at https://aistudio.google.com/apikey
# The free tier has daily limits, and Google may use free-tier prompts to
# improve its products, so use it for development and demos, not real users.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-lite-latest).
GEMINI_MODEL=
# Optional backup models, comma-separated, tried when the main one is busy
# (default: gemini-flash-latest,gemini-flash-lite-latest).
GEMINI_FALLBACK_MODELS=

# Natural voice for spoken answers (uses GEMINI_API_KEY). Optional:
# GEMINI_TTS=off to always use the browser's voice; GEMINI_TTS_VOICE to pick
# another Gemini voice (default Sulafat; e.g. Kore, Aoede, Achernar).
GEMINI_TTS_VOICE=

# Option 2 (paid): Anthropic Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5). claude-haiku-5-5 is a
# much cheaper option worth evaluating with `npm run eval -- --live`.
CLAUDE_MODEL=

# Option 3 (free, runs on your own computer): Ollama. Install it from
# https://ollama.com, run `ollama pull qwen2.5:3b`, then set AI_PROVIDER=ollama.
# No key and no daily limit, and questions never leave your computer, but
# answers are weaker than Gemini/Claude and only work while that computer is on.
# Default model qwen2.5:3b (about 2 GB, fine on a laptop without a GPU);
# qwen2.5:7b answers better if you have 8 GB+ free RAM or a GPU.
OLLAMA_URL=
OLLAMA_MODEL=
# How long to wait for an answer, in ms (default 120000; CPU-only is slow).
OLLAMA_TIMEOUT_MS=

# Optional port for `npm start` (default 8080). `npm run dev` always uses 5173.
PORT=

# Accounts database (SQLite file). Default: data/lawyerup.db in this folder.
# Delete that file (with the app stopped) to start with an empty database.
DB_PATH=
# The demo client account (demo@lawyerup.in / lawyerup123) is created on
# first run (with two past consultations). Set to false to skip it, e.g. on
# a public deployment.
SEED_DEMO_ACCOUNT=
# The dev-only demo lawyer (demo.lawyer@lawyerup.dev / lawyerup123) is always
# created by `npm run dev`; set to true to also create it under `npm start`.
SEED_DEMO_LAWYER=false
# Turn on the mock admin console's account routes in `npm start` (they are
# always on in `npm run dev`). Unauthenticated: private demos only.
ENABLE_MOCK_ADMIN=false

# ---------------------------------------------------------------------------
# Client-side (inlined at build time — never put secrets here).
# ---------------------------------------------------------------------------

# Show the unauthenticated mock admin console in a production build.
# Only for private demos. It is always available in `npm run dev`.
VITE_ENABLE_MOCK_ADMIN=false
